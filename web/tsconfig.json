{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Empty on purpose. TypeScript otherwise pulls ambient @types from any
    // node_modules up the directory tree, and one sitting in a home
    // directory made this project typecheck locally while failing in CI.
    // What the project needs is referenced explicitly in src/vite-env.d.ts.
    "types": []
  },
  "include": ["src", "vite.config.ts"]
}
